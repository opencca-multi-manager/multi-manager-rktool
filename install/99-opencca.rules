SUBSYSTEM=="usb", MODE="0660", GROUP="opencca-admin"
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", MODE="0660", GROUP="opencca-admin"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", MODE="0660", GROUP="opencca-admin"
ACTION=="add|change", SUBSYSTEM=="usb", RUN+="/bin/sh -c 'chgrp -f opencca-admin $sys$devpath/*port*/disable; chmod -f 660 $sys$devpath/*port*/disable'"

# Stable symlink for GPIO controller (ESP32)
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:02:01.0-usb-0:1.3.4.3:1.0", SYMLINK+="ttyGPIO", GROUP="opencca-admin", MODE="0660"

# Stable symlinks for board serial consoles (based on physical USB port)
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:02:01.0-usb-0:1.3.4.1.2:1.0", SYMLINK+="ttyBoard1", GROUP="opencca-admin", MODE="0660"
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:02:01.0-usb-0:1.3.4.1.3:1.0", SYMLINK+="ttyBoard2", GROUP="opencca-admin", MODE="0660"
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:02:01.0-usb-0:1.3.4.1.4:1.0", SYMLINK+="ttyBoard3", GROUP="opencca-admin", MODE="0660"